#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
#   Generic plan: TASK_NUMBER matches a `Task N` heading.
#   SDD tasks.md: TASK_NUMBER matches a `## NN-<name>` step section
#                 (accepts `1` or `01` for step 01). The whole step section
#                 (Goal, Tasks, Verification, Commit) is extracted so the
#                 implementer gets the full step context.
# Default OUTFILE: <repo-root>/.skillgrid/sdd/<NNN-slug>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  # Normalize SDD step numbers to two digits for stable artifact names.
  case "$n" in
    [0-9]) out="$dir/task-0${n}-brief.md" ;;
    *)     out="$dir/task-${n}-brief.md" ;;
  esac
fi

# Normalize to two digits for `## NN-<name>` matching (1 → 01).
case "$n" in
  [0-9]) nn="0$n" ;;
  *)     nn="$n" ;;
esac

# 1st pass: SDD step section `## NN-<name>` … up to the next `## ` heading.
awk -v nn="$nn" '
  /^```/ { infence = !infence; if (intask) print; next }
  infence { if (intask) print; next }
  /^## / {
    if ($0 ~ ("^## " nn "(-| |$)")) { intask = 1; print; next }
    else if (intask) { exit }
  }
  intask { print }
' "$plan" > "$out"

# 2nd pass (fallback): legacy generic `Task N` heading.
if [ ! -s "$out" ]; then
  awk -v n="$n" '
    /^```/ { infence = !infence }
    !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
      intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
    }
    intask { print }
  ' "$plan" > "$out"
fi

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan} (no '## ${nn}-<name>' step or 'Task ${n}' heading)" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
